# Скопируй в .env и заполни: cp .env.example .env
# .env не коммитится.

APP_ENV=local

# Локальный Postgres из docker-compose.yml
DATABASE_URL=postgres://uslugi:uslugi@localhost:5432/uslugi?sslmode=disable

# Токен тестового бота от @BotFather
BOT_TOKEN=

# Username бота без @. Можно не заполнять: веб-сервер спросит его у Telegram.
BOT_USERNAME=

# Адрес веб-сервера (админка и каталог)
HTTP_ADDR=:8080

# Telegram ID команды через запятую — их пускаем в админку.
# Свой ID бот пишет в ответ на /start.
TEAM_TELEGRAM_IDS=

# Часовой пояс для времени в админке
ADMIN_TIMEZONE=Asia/Ho_Chi_Minh
