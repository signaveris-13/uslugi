{$DOMAIN} {
	encode zstd gzip

	# Сводка о здоровье сервера для агента-адвайзера (deploy/status.sh).
	# Путь содержит секрет STATUS_TOKEN из deploy/.env.
	handle_path /ops/{$STATUS_TOKEN}/* {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		header Content-Type "text/plain; charset=utf-8"
		root * /srv/status
		file_server
	}

	reverse_proxy web:8080
}
