# Настройки сервера. install.sh создаёт deploy/.env из этого образца сам.

# staging — тестовый стенд, production — прод. На Stage в админке и приложении виден бейдж «Stage».
APP_ENV=production

# Адрес админки. Без своего домена: <IP через дефисы>.sslip.io, например 203-0-113-7.sslip.io
DOMAIN=

# Пароль базы: длинная случайная строка из букв и цифр
POSTGRES_PASSWORD=

# Токен бота. Один токен не может работать в двух местах сразу:
# пока бот запущен здесь, локальный make run-bot нужно остановить.
BOT_TOKEN=
BOT_USERNAME=

# Telegram ID команды через запятую — их пускаем в админку
TEAM_TELEGRAM_IDS=

ADMIN_TIMEZONE=Asia/Ho_Chi_Minh
